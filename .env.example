# Application Settings
APP_NAME=Grammar Correction API
APP_VERSION=1.0.0
DEBUG=False

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Settings (set MODEL_ID for runtime or build-time model download)
MODEL_ID=dipak-bigdrops/grammar-correction-model
HF_TOKEN=
MODEL_PATH=./model
MODEL_MAX_LENGTH=128
MODEL_NUM_BEAMS=5
MODEL_IDLE_UNLOAD_SECONDS=300

# OCR Settings
OCR_LANGUAGES=["en"]
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_MODEL_DIR=/app/.EasyOCR/model

# Processing Settings (MAX_FILE_SIZE default in config is 20MB)
MAX_FILE_SIZE=20971520
MAX_ZIP_EXTRACT_SIZE=52428800
MAX_FILES_IN_ZIP=100
CONTEXT_WORDS=3
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png"]
ALLOWED_HTML_EXTENSIONS=[".html",".htm"]
ALLOWED_ARCHIVE_EXTENSIONS=[".zip"]

# Cache Settings (in-memory). Only file-level cache is used; text/model/ocr/partial are reserved.
CACHE_TTL=3600
ENABLE_CACHING=True
CACHE_TTL_TEXT=86400
CACHE_TTL_MODEL=3600
CACHE_TTL_OCR=7200
CACHE_TTL_PARTIAL=1800
ENABLE_TEXT_CACHING=True
ENABLE_MODEL_CACHING=True
ENABLE_OCR_CACHING=True
ENABLE_PARTIAL_CACHING=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Monitoring
ENABLE_METRICS=True

# CORS (optional; defaults in config)
ALLOWED_ORIGINS=["*"]
